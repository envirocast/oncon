# Model provider (optional; without a key the built-in approved-content engine answers).
# If both keys are set, OpenRouter is used. Force one with LLM_PROVIDER=gemini or openrouter.

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models (default: openai/gpt-4o-mini)
OPENROUTER_MODEL=

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase (optional): account sync and opt-in research sharing. Create a project for Onconnect, run supabase/migrations/*.sql, then fill these in.
# Project settings > API. The publishable (or legacy anon) key is safe in the browser: row level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
